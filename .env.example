# Sao chép thành .env và điền Spreadsheet ID của Google Sheet.
GOOGLE_SHEETS_SPREADSHEET_ID=

# Không bắt buộc nếu đặt file tại credentials/service-account.json.
# Có thể dùng đường dẫn tuyệt đối tới file JSON trên máy này.
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json

# Tùy chọn: cấu hình Vnstock v6 theo nguồn đã đăng ký API, ví dụ ssi hoặc fhsc.
# SSI cần SSI_API_KEY và SSI_API_SECRET; FHSC cần FHSC_API_KEY.
VNSTOCK_SOURCE=ssi
VNSTOCK_REFERENCE_SOURCE=ssi
VNSTOCK_FUNDAMENTAL_SOURCE=fhsc
